# Copiar este archivo como .env y poner los valores reales. El .env no se sube a GitHub.
# TARGET elige el ambiente: local (Docker) o demo (demo pública de OrangeHRM)
TARGET=local

# Instancia local de OrangeHRM 5.9 en Docker
LOCAL_URL=http://127.0.0.1:8200
LOCAL_ADMIN_USER=
LOCAL_ADMIN_PASS=

# Demo pública (las credenciales aparecen en la misma página de login de la demo)
DEMO_URL=https://opensource-demo.orangehrmlive.com
DEMO_ADMIN_USER=
DEMO_ADMIN_PASS=
